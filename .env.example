# Example environment for running the API container (docker run --env-file .env ...).
# Copy to .env and fill in real values. Never commit the filled-in file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=80

REDIS_HOST=dmp-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

ConnectionStrings__DmpConnection=Host=postgres-dmp;Port=5432;Database=dmarketplace;Username=admin;Password=change-me
ConnectionStrings__BillingDbConnection=Host=dmp-db-billing;Port=5432;Database=billing;Username=admin;Password=change-me

JwtSettings__SecretKey=change-me-to-a-random-secret-of-at-least-32-characters
JwtRegistrationSettings__SecretKey=change-me-to-another-random-secret-of-at-least-32-chars

BitcartBackend__Url=http://bitcart-backend:8000/

BasicAuthorize__User=invoiceworker
BasicAuthorize__Password=change-me

Minio__endpoint=dmp-minio:9000
Minio__accessKey=change-me
Minio__secretKey=change-me
Minio__s3PublicEndpoint=https://s3.example.com
Minio__SellerSettings__accessKey=change-me
Minio__SellerSettings__secretKey=change-me
Minio__ClientSettings__accessKey=change-me
Minio__ClientSettings__secretKey=change-me

DmpHosts__Client=https://example.com
DmpHosts__Seller=https://seller.example.com

CfSettings__TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

Cors__AllowedOrigins__0=https://example.com
Cors__AllowedOrigins__1=https://seller.example.com
